#!/bin/bash

# for sxhkd
pgrep -x sxhkd >/dev/null || sxhkd &

#for dunst
pgrep -x dunst >/dev/null || dunst &

# appearance ranom
bspc config border_width 2
bspc config window_gap 7
bspc focused_border_color "#ffb86c"
bspc normal_border_color "#44475a"
bspc config focus_follows_pointer true
bspc config pointer_follows_focus false

# workspaces
bspc monitor -d 1 2 3 4 5
bspc config top_padding 40
bspc config bottom_padding 0
bspc config left_padding 0
bspc config right_padding 0

# behavior
bspc config split_ratio 0.5
bspc config borderless_monocle true
bspc config gapless_monocle true

bspc config click_to_focus any

# dont make cursor an X
xsetroot -cursor_name left_ptr &

# polybar
"$HOME/.config/polybar/launch.sh" &

# picom
pgrep -x picom >/dev/null || picom --config "$HOME/.config/picom/picom.conf" &

####### good looking stuff

# wallpaper
feh --bg-fill "$HOME/.config/bspwm/wallpapers/green.jpg" &

# conky
pgrep -x conky >/dev/null || conky -c "$HOME/.config/conky/conkyrc" &

# touchpad making tap and all
TOUCHPAD=$(xinput list --name-only | grep -iE 'touchpad|trackpad' | head -n1)

if [ -n "$TOUCHPAD" ]; then
    xinput set-prop "$TOUCHPAD" "libinput Tapping Enabled" 1
    xinput set-prop "$TOUCHPAD" "libinput Natural Scrolling Enabled" 1
fi
