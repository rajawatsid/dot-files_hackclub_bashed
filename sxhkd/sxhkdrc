# This is for the shortcuts

# terminal
super + Return
    kitty

# program launcher
super + d
    rofi -show drun

# file opener
super + o
    rofi -show filebrowser

# window switcher
super + Tab
    rofi -show window

# file browser
super + alt + n
    nemo

# quit or restart bspwm
super + alt + {q,r}
    bspc {quit, wm -r}

# close window
super + w
    bspc node -c

## mode toggle

# monocle
super + m
    bspc desktop -l next

# floating
super + shift + f
    bspc node -t ~floating

# full screen
super + f
    bspc node -t ~fullscreen

## desktop things

# switching desktops
super + {1,2,3,4,5}
    bspc desktop -f '^{1,2,3,4,5}'

# move window to desktop
super + shift + {1,2,3,4,5}
    bspc node -d '^{1,2,3,4,5}'

# Move floating windows with arrow keys
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# expand window
super + alt + {h,j,k,l}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# give window contractions
super + alt + shift + {h,j,k,l}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

