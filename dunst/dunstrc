[global]
    monitor = 0
    follow = mouse

    width = (280, 360)
    height = (0, 200)
    origin = top-right
    offset = (18, 47)
    notification_limit = 5
    gap_size = 10

    transparency = 0
    corner_radius = 14
    frame_width = 2
    frame_color = "#71845B"
    separator_height = 0
    separator_color = frame
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 14
    highlight = "#91A477"

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    sort = yes
    idle_threshold = 120
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# urgency stuff
[urgency_low]
    background = "#263321"
    foreground = "#91A477"
    frame_color = "#526347"
    highlight = "#91A477"
    timeout = 5

[urgency_normal]
    background = "#263321"
    foreground = "#F2F5E9"
    frame_color = "#71845B"
    highlight = "#91A477"
    timeout = 8

[urgency_critical]
    background = "#263321"
    foreground = "#F2F5E9"
    frame_color = "#A64B45"
    highlight = "#A64B45"
    timeout = 0

# vol and brighness stuff
[volume]
    appname = "volume"
    set_stack_tag = "volume"
[brightness]
    appname = "brightness"
    set_stack_tag = "brightness"