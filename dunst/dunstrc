
[global]
    monitor = 0
    follow = mouse



    width = (300, 380)
    height = (0, 220)
    origin = top-right
    offset = (18, 47)
    notification_limit = 5
    gap_size = 12



    transparency = 0
    corner_radius = 16
    frame_width = 2
    frame_color = "#71845B"

    separator_height = 1
    separator_color = "#3d4e29"

    padding = 18
    horizontal_padding = 18
    text_icon_padding = 14
    highlight = "#91A477"



    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4



    font = JetBrainsMono Nerd Font 10
    line_height = 3
    markup = full

    format = "<span foreground='#91A477' size='small' weight='bold'>%a</span>\n<b>%s</b>\n<span foreground='#D4DFC7'>%b</span>"

    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no



    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 36
    max_icon_size = 44

    sort = yes
    idle_threshold = 120
    sticky_history = yes
    history_length = 30

    dmenu = /usr/bin/rofi -dmenu -p "notifications:"
    browser = /usr/bin/xdg-open
    always_run_script = true

    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all


# urgency

[urgency_low]
    background = "#263321"
    foreground = "#91A477"
    frame_color = "#526347"
    highlight = "#91A477"
    timeout = 4
    

[urgency_normal]
    background = "#263321"
    foreground = "#F2F5E9"
    frame_color = "#71845B"
    highlight = "#91A477"
    timeout = 6

[urgency_critical]
    background = "#30201E"
    foreground = "#F2F5E9"
    frame_color = "#A64B45"
    highlight = "#D4776C"
    timeout = 0

[volume]
    appname = "volume"
    set_stack_tag = "volume"


[brightness]
    appname = "brightness"
    set_stack_tag = "brightness"